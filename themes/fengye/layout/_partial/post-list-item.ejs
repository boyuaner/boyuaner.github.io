<!-- One post item in a list -->
<div class="
    post-container
    px-2 py-2
    flex flex-col gap-3">
    <div class="flex flex-row items-center gap-4 max-h-36">
        <% if (post.thumbnail) { %>
            <% var postDir = url_for(post.path); %>
            <!-- Post thumbnail -->
            <a href="<%- url_for(post.path) %>" class="flex h-full w-64 sm:max-w-48">
                <img class="
                    rounded-md
                    object-cover
                    transition-all
                    hover:scale-105
                    hover:shadow-md"
                    src="<%-post.thumbnail %>"
                    alt="<%- post.thumbnail_alt %>">
                </img>
            </a>
            <% } %>
            <div class="flex flex-col gap-1">
                <!-- Post title -->
                <a href="<%- url_for(post.path) %>">
                    <h2 class="
                        text-[var(--c-80)]
                        font-bold
                        text-xl
                        hover:text-[var(--c-theme)]
                        transition-all
                        hover:underline">
                        <%- post.title  %>
                        <!-- <%-  url_for(post.path) + post.thumbnail %> -->
                    </h2>
                </a>
            <!-- Post excerpt -->
            <% if (post.excerpt) { %>
                <div class="post-excerpt post-content text-[var(--c-60)] text-sm line-clamp-5 border-b-1 border-[var(--c-sep)]">
                    <%- post.excerpt -%>
                </div>
            <% } %>
            </div>
        </div>
        <!-- Tags -->
        <div>
            <% if (show_tags) { %>
                <%- partial('tag-list', {tags: post.tags}) %>
            <% } %>
        </div>
</div>
